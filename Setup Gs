function ensureSettingsConfig(ss, nowFormatted) {
  var settingSheet = ss.getSheetByName('Settings');
  if (!settingSheet || settingSheet.getLastRow() <= 1) return;

  var lastRow = settingSheet.getLastRow();
  var rows = settingSheet.getRange(2, 1, lastRow - 1, 2).getDisplayValues();
  var existingKeys = [];

  for (var i = 0; i < rows.length; i++) {
    var keyName = rows[i][0].toString().trim().toUpperCase();
    var curVal = rows[i][1].toString().trim();
    existingKeys.push(keyName);

    // Otomatis perbarui model deprecated gemini-2.5-flash ke gemini-3.6-flash
    if ((keyName === 'GEMINI_MODEL_TEXT' || keyName === 'GEMINI_MODEL_VISION') && curVal === 'gemini-2.5-flash') {
      settingSheet.getRange(i + 2, 2).setValue('gemini-3.6-flash');
      settingSheet.getRange(i + 2, 4).setValue(nowFormatted);
    }
  }

  if (existingKeys.indexOf('GEMINI_MODEL_TEXT') === -1) {
    settingSheet.appendRow(['GEMINI_MODEL_TEXT', 'gemini-3.6-flash', 'Model AI Google AI Studio untuk Chatbox Asisten', nowFormatted]);
  }
  if (existingKeys.indexOf('GEMINI_MODEL_VISION') === -1) {
    settingSheet.appendRow(['GEMINI_MODEL_VISION', 'gemini-3.6-flash', 'Model AI Google AI Studio untuk OCR Struk Belanja', nowFormatted]);
  }
  if (existingKeys.indexOf('RAILWAY_DEFAULT_ENDPOINT') === -1) {
    settingSheet.appendRow(['RAILWAY_DEFAULT_ENDPOINT', 'https://btwa-finance-production.up.railway.app', 'Endpoint Utama Server Railway Bot WhatsApp AxaXyz', nowFormatted]);
  }
  if (existingKeys.indexOf('API_SECRET_TOKEN') === -1) {
    settingSheet.appendRow(['API_SECRET_TOKEN', 'AXA_XYZ_SECRET_2026', 'Token Otentikasi Sinkronisasi Internal Railway', nowFormatted]);
  }
}

function getOrCreateRootDriveFolder() {
  var rootName = 'Portal_Bot_Keuangan_AxaXyz';
  var folders = DriveApp.getFoldersByName(rootName);
  if (folders.hasNext()) {
    return folders.next();
  }
  return DriveApp.createFolder(rootName);
}
