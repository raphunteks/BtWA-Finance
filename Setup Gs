  ]
};

function initialSetup() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var timezone = 'Asia/Jakarta';
    var nowFormatted = Utilities.formatDate(new Date(), timezone, 'dd/MM/yyyy HH:mm:ss');
    
    // 1. Periksa & Inisialisasi Sheet berdasarkan skema
    for (var sheetName in DB_SCHEMAS) {
      if (DB_SCHEMAS.hasOwnProperty(sheetName)) {
        var sheet = ss.getSheetByName(sheetName);
        var expectedHeaders = DB_SCHEMAS[sheetName];

        if (!sheet) {
          sheet = ss.insertSheet(sheetName);
        }

        var lastRow = sheet.getLastRow();
        var lastCol = sheet.getLastColumn();

        if (lastRow === 0) {
          sheet.getRange(1, 1, 1, expectedHeaders.length).setValues([expectedHeaders]);
          formatHeaderRow(sheet, expectedHeaders.length);
        } else {
          var currentHeadersRange = sheet.getRange(1, 1, 1, Math.max(lastCol, expectedHeaders.length));
          var currentHeaders = currentHeadersRange.getDisplayValues()[0];
          for (var i = 0; i < expectedHeaders.length; i++) {
            if (currentHeaders[i] !== expectedHeaders[i]) {
              sheet.getRange(1, i + 1).setValue(expectedHeaders[i]);
            }
          }
          formatHeaderRow(sheet, expectedHeaders.length);
        }
      }
    }

    // 2. Inisialisasi Data Default (Admin & Settings Saja, Sheet Clients Dibiarkan Kosong)
    seedInitialData(ss, nowFormatted);

    // 3. Safe Migration: Pastikan model AI dan Default Railway Endpoint terdaftar
    ensureSettingsConfig(ss, nowFormatted);

    // 4. Buat / Pastikan Folder Induk Google Drive tersedia
    getOrCreateRootDriveFolder();

    SpreadsheetApp.flush();
    Logger.log('Inisialisasi database AxaXyz berhasil (Sheet Clients bersih tanpa data dummy).');
    return { success: true, message: 'Setup database AxaXyz berhasil diselesaikan. Kolom Clients bersih dan siap digunakan.' };

  } catch (error) {
    Logger.log('Error saat initialSetup: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function formatHeaderRow(sheet, colCount) {
  var headerRange = sheet.getRange(1, 1, 1, colCount);
  headerRange.setFontWeight('bold')
             .setBackground('#0284C7')
             .setFontColor('#FFFFFF')
             .setHorizontalAlignment('center')
             .setVerticalAlignment('middle');
  sheet.setFrozenRows(1);
}

