function loginUser(username, password) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Admin_Users');
    if (!sheet) {
      return { success: false, message: 'Database tabel Admin_Users tidak ditemukan.' };
    }

    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) {
      return { success: false, message: 'Belum ada data user terdaftar. Silakan jalankan initialSetup() pada setup.gs.' };
    }

    var data = sheet.getRange(2, 1, lastRow - 1, 6).getDisplayValues();
    var matchedUser = null;

    for (var i = 0; i < data.length; i++) {
      var row = data[i];
      if (row[1] === username && row[2] === password) {
        if (row[4] !== 'Active') {
          return { success: false, message: 'Akun Anda sedang dinonaktifkan. Hubungi Master Administrator.' };
        }
        matchedUser = {
          id: row[0],
          username: row[1],
          role: row[3],
          status: row[4],
          createdAt: row[5]
        };
        break;
      }
    }

    if (matchedUser) {
      logAudit(matchedUser.username, matchedUser.role, 'AUTH_LOGIN', matchedUser.id, 'Pengguna berhasil login ke portal', 'SUCCESS');
      return { success: true, user: matchedUser };
    } else {
      logAudit(username, 'Guest', 'AUTH_FAILED', '-', 'Percobaan login gagal dengan username: ' + username, 'FAILED');
      return { success: false, message: 'Kombinasi Username dan Password tidak cocok.' };
    }
  } catch (err) {
    return { success: false, message: 'Terjadi kesalahan sistem: ' + err.toString() };
  }
}

function getClientsPaginated(params) {
  try {
    params = params || {};
    var page = parseInt(params.page, 10) || 1;
    var pageSize = parseInt(params.pageSize, 10) || 10;
    var searchQuery = (params.search || '').toLowerCase().trim();
    var statusFilter = (params.status || 'ALL').toUpperCase();

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Clients');
    if (!sheet) return { clients: [], totalCount: 0, page: 1, totalPages: 1 };

    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) {
      return { clients: [], totalCount: 0, page: 1, totalPages: 1 };
    }

    var rawData = sheet.getRange(2, 1, lastRow - 1, 8).getDisplayValues();
    var filtered = [];

    for (var i = 0; i < rawData.length; i++) {
      var row = rawData[i];
      var clientId = row[0];
      var clientName = row[1];
      var waNumber = row[2];
      var endpoint = row[3];
      var driveFolderId = row[4];
      var sessionStatus = row[5];
      var expiredDate = row[6];
      var createdAt = row[7];

      if (statusFilter !== 'ALL' && sessionStatus.toUpperCase() !== statusFilter) {
        continue;
      }

      if (searchQuery) {
        var matchText = (clientId + ' ' + clientName + ' ' + waNumber + ' ' + endpoint).toLowerCase();
        if (matchText.indexOf(searchQuery) === -1) {
          continue;
        }
      }

      filtered.push({
        clientId: clientId,
        clientName: clientName,
        waNumber: waNumber,
        railwayEndpoint: endpoint,
        driveFolderId: driveFolderId,
        sessionStatus: sessionStatus,
        expiredDate: expiredDate,
        createdAt: createdAt
      });
    }

    var totalCount = filtered.length;
    var totalPages = Math.ceil(totalCount / pageSize) || 1;
    if (page > totalPages) page = totalPages;

    var offset = (page - 1) * pageSize;
    var pagedData = filtered.slice(offset, offset + pageSize);

    return {
      clients: pagedData,
      totalCount: totalCount,
      page: page,
      totalPages: totalPages
    };
  } catch (err) {
    return { clients: [], totalCount: 0, page: 1, totalPages: 1, error: err.toString() };
  }
}

function saveClient(clientData, currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Clients');
    if (!sheet) throw new Error('Sheet Clients tidak ditemukan di database.');

    var timezone = 'Asia/Jakarta';
    var nowFormatted = Utilities.formatDate(new Date(), timezone, 'dd/MM/yyyy HH:mm:ss');
    var isNew = !clientData.clientId;
    var clientId = isNew ? getNextSequentialId('Clients', 1, 'CLI') : clientData.clientId;

    var defaultRailway = getSettingValue('RAILWAY_DEFAULT_ENDPOINT') || 'https://btwa-finance-production.up.railway.app';
    var endpoint = (clientData.railwayEndpoint || '').trim() || defaultRailway;

    var driveFolderId = clientData.driveFolderId || '';
    if (!driveFolderId) {
      var folder = getOrCreateClientFolder(clientId, clientData.clientName);
      if (folder) {
        driveFolderId = folder.getId();
      }
    }

    if (isNew) {
      var newRow = [
        clientId,
        clientData.clientName,
        clientData.waNumber,
        endpoint,
        driveFolderId,
        clientData.sessionStatus || 'Disconnected',
        clientData.expiredDate || '31/12/2026',
        nowFormatted
      ];
      sheet.appendRow(newRow);
      SpreadsheetApp.flush();

      logAudit(currentUser.username, currentUser.role, 'CLIENT_CREATE', clientId, 'Tambah client baru: ' + clientData.clientName, 'SUCCESS');
      return { success: true, clientId: clientId, message: 'Client baru berhasil didaftarkan.' };
    } else {
      var lastRow = sheet.getLastRow();
      var idValues = sheet.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
      var targetRowIndex = -1;

      for (var r = 0; r < idValues.length; r++) {
        if (idValues[r][0] === clientId) {
          targetRowIndex = r + 2;
          break;
        }
      }

      if (targetRowIndex === -1) throw new Error('Data Client ID ' + clientId + ' tidak ditemukan.');

      sheet.getRange(targetRowIndex, 2).setValue(clientData.clientName);
      sheet.getRange(targetRowIndex, 3).setValue(clientData.waNumber);
      sheet.getRange(targetRowIndex, 4).setValue(endpoint);
      sheet.getRange(targetRowIndex, 5).setValue(driveFolderId);
      sheet.getRange(targetRowIndex, 6).setValue(clientData.sessionStatus);
      sheet.getRange(targetRowIndex, 7).setValue(clientData.expiredDate);

      SpreadsheetApp.flush();
      logAudit(currentUser.username, currentUser.role, 'CLIENT_UPDATE', clientId, 'Pembaruan data client: ' + clientData.clientName, 'SUCCESS');
      return { success: true, clientId: clientId, message: 'Informasi client berhasil diperbarui.' };
    }
  } catch (err) {
    logAudit(currentUser ? currentUser.username : 'Unknown', currentUser ? currentUser.role : 'Guest', 'CLIENT_MUTATION_FAILED', clientData.clientId || '-', err.toString(), 'FAILED');
    return { success: false, message: err.toString() };
  }
}

