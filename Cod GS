          '</tr>';
      }
    }

    htmlContent += '</tbody></table>' +
      '<div class="footer">Dokumen cetak otomatis Google Sheets Apps Script Portal Bot Keuangan AxaXyz. Sah tanpa tanda tangan basah.</div>' +
      '</body></html>';

    var blob = HtmlService.createHtmlOutput(htmlContent).getAs('application/pdf');
    var fileName = 'Laporan_Keuangan_' + (clientId || 'Global') + '_' + Date.now() + '.pdf';
    blob.setName(fileName);

    var folder = driveFolderId ? DriveApp.getFolderById(driveFolderId) : getOrCreateRootDriveFolder();
    var pdfFile = folder.createFile(blob);
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    logAudit(currentUser.username, currentUser.role, 'EXPORT_PDF', clientId || 'ALL', 'Ekspor berkas PDF laporan keuangan', 'SUCCESS');

    return {
      success: true,
      fileUrl: pdfFile.getUrl(),
      downloadUrl: pdfFile.getDownloadUrl(),
      fileName: fileName
    };
  } catch (err) {
    return { success: false, message: 'Gagal mengekspor PDF: ' + err.toString() };
  }
}

function getAuditLogsPaginated(limit) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Audit_Logs');
    if (!sheet) return [];

    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) return [];

    var take = limit || 20;
    var startRow = Math.max(2, lastRow - take + 1);
    var count = lastRow - startRow + 1;

    var logs = sheet.getRange(startRow, 1, count, 8).getDisplayValues();
    return logs.reverse();
  } catch (err) {
    return [];
  }
}

function getNextSequentialId(sheetName, idColIndex, prefix) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) return prefix + '-20260904-0001';

  var timezone = 'Asia/Jakarta';
  var dateTag = Utilities.formatDate(new Date(), timezone, 'yyyyMMdd');
  var expectedPrefix = prefix + '-' + dateTag + '-';

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) {
    return expectedPrefix + '0001';
  }

  var idRange = sheet.getRange(2, idColIndex, lastRow - 1, 1);
  var rawIds = idRange.getDisplayValues();
  var maxSeq = 0;

  for (var i = 0; i < rawIds.length; i++) {
    var currentId = rawIds[i][0];
    if (currentId && currentId.indexOf(expectedPrefix) === 0) {
      var seqStr = currentId.substring(expectedPrefix.length);
      var seqNum = parseInt(seqStr, 10);
      if (!isNaN(seqNum) && seqNum > maxSeq) {
        maxSeq = seqNum;
      }
    }
  }

  var nextSeqNum = maxSeq + 1;
  var paddedSeq = ('0000' + nextSeqNum).slice(-4);
  return expectedPrefix + paddedSeq;
}
