function doGet(e) {
  // 1. Layani endpoint query API eksternal (dari Engine Railway atau Vercel)
  if (e && e.parameter && e.parameter.action) {
    var action = e.parameter.action;

    if (action === 'ping') {
      return ContentService.createTextOutput(JSON.stringify({
        status: 'ONLINE',
        mode: 'DUAL_CONNECTION_GAS_READY',
        timestamp: new Date().toISOString()
      })).setMimeType(ContentService.MimeType.JSON);
    }

    if (action === 'getBalanceSummary') {
      var senderNumber = (e.parameter.senderNumber || '').toString().trim();
      var summaryResult = getBalanceSummaryForBot(senderNumber);
      return ContentService.createTextOutput(JSON.stringify(summaryResult))
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (action === 'getReminderClients') {
      var token = (e.parameter.token || '').toString().trim();
      var reminderResult = getReminderClientsForBot(token);
      return ContentService.createTextOutput(JSON.stringify(reminderResult))
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (action === 'viewReportPDF') {
      var sNum = (e.parameter.senderNumber || '').toString().trim();
      return handleDirectPdfRedirect(sNum);
    }
  }

  // 2. Standar: Render Antarmuka HTML Web App
  return HtmlService.createTemplateFromFile('index')
    .evaluate()
    .setTitle('Portal Bot WA Keuangan Multi-Client - AxaXyz')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function doPost(e) {
  try {
    var rawData = (e && e.postData && e.postData.contents) ? e.postData.contents : '{}';
    var parsed = JSON.parse(rawData);
    var action = parsed.action || '';
    var data = parsed.data || parsed; // Mendukung format flat payload dari bot maupun wrapper dari Vercel
    var currentUser = parsed.currentUser || null;

    var responseData = { success: false, message: 'Action tidak dikenali: ' + action };

    // Router Aksi API Universal Dual-Connection & Bot Engine Sync
    if (action === 'recordTransaction') {
      responseData = recordTransactionFromBot(data);
    } else if (action === 'cancelTransaction') {
      responseData = cancelTransactionFromBot(data.trxId || parsed.trxId);
    } else if (action === 'loginUser') {
      responseData = loginUser(data.username, data.password);
    } else if (action === 'getClientsPaginated') {
      responseData = getClientsPaginated(data);
    } else if (action === 'saveClient') {
      responseData = saveClient(data.clientData, currentUser);
    } else if (action === 'deleteClient') {
      responseData = deleteClient(data.clientId, currentUser);
    } else if (action === 'fetchRailwaySession') {
      responseData = fetchRailwaySession(data.endpoint);
    } else if (action === 'getFinancialAnalytics') {
      responseData = getFinancialAnalytics(data.clientId);
    } else if (action === 'processReceiptOCR') {
      responseData = processReceiptOCR(data.payload, currentUser);
    } else if (action === 'askGeminiChat') {
      responseData = askGeminiChat(data.message);
    } else if (action === 'exportFinancialReportPDF') {
      responseData = exportFinancialReportPDF(data.clientId, currentUser);
    } else if (action === 'getAuditLogsPaginated') {
      responseData = { success: true, logs: getAuditLogsPaginated(data.limit) };
    } else if (action === 'getAllSettings') {
      responseData = getAllSettings(currentUser);
    } else if (action === 'saveAllSettings') {
      responseData = saveAllSettings(data.settingsMap, currentUser);
    } else if (action === 'testGeminiConnection') {
      responseData = testGeminiConnection(data.apiKey, data.model, currentUser);
    }

    return ContentService.createTextOutput(JSON.stringify(responseData))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (postErr) {
    return ContentService.createTextOutput(JSON.stringify({
      success: false,
      message: 'Server Error: ' + postErr.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

/**
 * Perekaman Transaksi Otomatis dari Engine Bot WhatsApp Railway
 */
function recordTransactionFromBot(data) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var trxSheet = ss.getSheetByName('Financial_Trx');
    var clientSheet = ss.getSheetByName('Clients');

    if (!trxSheet) throw new Error('Sheet Financial_Trx tidak ditemukan di database.');

    var timezone = 'Asia/Jakarta';
    var nowFormatted = Utilities.formatDate(new Date(), timezone, 'dd/MM/yyyy HH:mm:ss');
    var trxId = data.trxId || getNextSequentialId('Financial_Trx', 1, 'TRX');
    var senderNumber = (data.senderNumber || '').toString().replace(/[^0-9]/g, '');

    // 1. Identifikasi Client_ID dan Folder Drive Client
    var clientId = 'CLI-GENERAL';
    var clientName = data.senderName || 'Pelanggan Bot';
    var targetDriveFolderId = '';

    if (clientSheet && clientSheet.getLastRow() > 1) {
      var clientRows = clientSheet.getRange(2, 1, clientSheet.getLastRow() - 1, 5).getDisplayValues();
      for (var i = 0; i < clientRows.length; i++) {
        var cleanWa = (clientRows[i][2] || '').toString().replace(/[^0-9]/g, '');
        if (cleanWa === senderNumber || (senderNumber && cleanWa.indexOf(senderNumber) !== -1)) {
          clientId = clientRows[i][0];
          clientName = clientRows[i][1];
          targetDriveFolderId = clientRows[i][4];
          break;
        }
      }
    }

    // 2. Simpan Foto Bukti Struk ke Google Drive (jika data foto Base64 disertakan)
    var driveFileUrl = '';
    if (data.imageBase64) {
      try {
        var targetFolder = targetDriveFolderId ? DriveApp.getFolderById(targetDriveFolderId) : getOrCreateClientFolder(clientId, clientName);
        var mimeType = data.mimeType || 'image/jpeg';
        var imgBytes = Utilities.base64Decode(data.imageBase64);
        var fileName = 'Struk_WA_' + trxId + '_' + Date.now() + '.jpg';
        var fileBlob = Utilities.newBlob(imgBytes, mimeType, fileName);
        var savedFile = targetFolder.createFile(fileBlob);
        savedFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
        driveFileUrl = savedFile.getUrl();
      } catch (driveErr) {
        Logger.log('Peringatan penyimpanan gambar Drive: ' + driveErr.toString());
      }
    }

    // 3. Masukkan Baris Transaksi ke Sheet Financial_Trx
    var rawNumber = parseFloat(data.amount) || 0;
    var rawNote = data.note || '';
    if (data.wallet && rawNote.indexOf(data.wallet) === -1) {
      rawNote += ' (#' + data.wallet + ')';
    }

    var newRow = [
      trxId,
      clientId,
      data.date || Utilities.formatDate(new Date(), timezone, 'dd/MM/yyyy'),
      data.type || 'Pengeluaran',
      data.category || 'Operasional',
      data.merchant || 'Transaksi Toko',
      rawNumber,
      rawNote,
      driveFileUrl,
      JSON.stringify(data),
      nowFormatted
    ];

    trxSheet.appendRow(newRow);
    SpreadsheetApp.flush();

    logAudit('AxaBOT_Engine', 'Bot', 'BOT_RECORD_TRX', trxId, 'Input transaksi WhatsApp dari ' + senderNumber + ' (' + clientName + ')', 'SUCCESS');

    return {
      success: true,
      trxId: trxId,
      clientId: clientId,
      driveFileUrl: driveFileUrl,
      message: 'Transaksi sukses disimpan ke Google Sheet Financial_Trx.'
    };

  } catch (err) {
    logAudit('AxaBOT_Engine', 'Bot', 'BOT_RECORD_FAILED', data.trxId || '-', err.toString(), 'FAILED');
    return { success: false, message: 'Gagal mencatat transaksi: ' + err.toString() };
  }
}

/**
 * Pembatalan Transaksi Otomatis (Quick Undo via WhatsApp)
 */
function cancelTransactionFromBot(trxId) {
  try {
    if (!trxId) throw new Error('ID Transaksi tidak disertakan.');

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Financial_Trx');
    if (!sheet) throw new Error('Sheet Financial_Trx tidak ditemukan.');

    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) throw new Error('Sheet Financial_Trx kosong.');

    var idRange = sheet.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
    var targetRowIndex = -1;

    for (var i = 0; i < idRange.length; i++) {
      if (idRange[i][0] === trxId) {
        targetRowIndex = i + 2;
        break;
      }
    }

    if (targetRowIndex === -1) throw new Error('ID Transaksi ' + trxId + ' tidak ditemukan.');

    // Ubah Type menjadi Dibatalkan agar analitik arus kas otomatis mengabaikannya
    sheet.getRange(targetRowIndex, 4).setValue('Dibatalkan');
    var existingNote = sheet.getRange(targetRowIndex, 8).getDisplayValue();
    sheet.getRange(targetRowIndex, 8).setValue('[BATAL/VOID] ' + existingNote);

    SpreadsheetApp.flush();
    logAudit('AxaBOT_Engine', 'Bot', 'BOT_CANCEL_TRX', trxId, 'Quick Undo via WhatsApp berhasil dibatalkan', 'SUCCESS');

    return { success: true, message: 'Transaksi ' + trxId + ' berhasil dibatalkan di buku kas.' };

  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

/**
 * Ringkasan Saldo Berdasarkan Nomor WhatsApp Pengirim
 */
function getBalanceSummaryForBot(senderNumber) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var trxSheet = ss.getSheetByName('Financial_Trx');
    var clientSheet = ss.getSheetByName('Clients');

    var targetClientId = 'ALL';
    var cleanSender = (senderNumber || '').replace(/[^0-9]/g, '');

    // Cari Client ID berdasarkan senderNumber
    if (cleanSender && clientSheet && clientSheet.getLastRow() > 1) {
      var cRows = clientSheet.getRange(2, 1, clientSheet.getLastRow() - 1, 3).getDisplayValues();
      for (var i = 0; i < cRows.length; i++) {
        var cWa = (cRows[i][2] || '').replace(/[^0-9]/g, '');
        if (cWa === cleanSender || (cleanSender && cWa.indexOf(cleanSender) !== -1)) {
          targetClientId = cRows[i][0];
          break;
        }
      }
    }

    var totalInflow = 0;
    var totalOutflow = 0;
    var wallets = {
      'Tunai': 0,
      'BCA': 0,
      'Mandiri': 0,
      'BRI': 0,
      'GoPay': 0,
      'OVO': 0,
      'DANA': 0,
      'ShopeePay': 0
    };

    if (trxSheet && trxSheet.getLastRow() > 1) {
      var rows = trxSheet.getRange(2, 1, trxSheet.getLastRow() - 1, 8).getDisplayValues();
      for (var j = 0; j < rows.length; j++) {
        var rowCId = rows[j][1];
        var type = (rows[j][3] || '').toLowerCase();
        var amount = parseFloat(rows[j][6].replace(/[^0-9.-]+/g, '')) || 0;
        var note = rows[j][7] || '';

        if (type === 'dibatalkan') continue;
        if (targetClientId !== 'ALL' && rowCId !== targetClientId) continue;

        // Deteksi dompet dari teks catatan
        var detectedWallet = 'Tunai';
        for (var w in wallets) {
          if (note.toUpperCase().indexOf('#' + w.toUpperCase()) !== -1) {
            detectedWallet = w;
            break;
          }
        }

        if (type === 'pemasukan') {
          totalInflow += amount;
          wallets[detectedWallet] = (wallets[detectedWallet] || 0) + amount;
        } else if (type === 'pengeluaran') {
          totalOutflow += amount;
          wallets[detectedWallet] = (wallets[detectedWallet] || 0) - amount;
        }
      }
    }

    return {
      success: true,
      totalInflow: totalInflow,
      totalOutflow: totalOutflow,
      netBalance: totalInflow - totalOutflow,
      wallets: wallets
    };

  } catch (err) {
    return { success: false, totalInflow: 0, totalOutflow: 0, netBalance: 0, wallets: {} };
  }
}

/**
 * Mengambil Klien Aktif untuk Daily Push Reminder Cron
 */
function getReminderClientsForBot(token) {
  try {
    var validToken = getSettingValue('API_SECRET_TOKEN') || 'AXA_XYZ_SECRET_2026';
    if (token !== validToken) {
      return { success: false, message: 'Unauthorized Token', clients: [] };
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Clients');
    if (!sheet || sheet.getLastRow() <= 1) {
      return { success: true, clients: [] };
    }

    var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 6).getDisplayValues();
    var clients = [];

    for (var i = 0; i < rows.length; i++) {
      if (rows[i][5] === 'Connected' && rows[i][2]) {
        clients.push({
          clientId: rows[i][0],
          clientName: rows[i][1],
          waNumber: rows[i][2]
        });
      }
    }

    return { success: true, clients: clients };
  } catch (e) {
    return { success: false, clients: [] };
  }
}

function handleDirectPdfRedirect(senderNumber) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var clientSheet = ss.getSheetByName('Clients');
  var targetCId = 'ALL';

  if (senderNumber && clientSheet && clientSheet.getLastRow() > 1) {
    var cRows = clientSheet.getRange(2, 1, clientSheet.getLastRow() - 1, 3).getDisplayValues();
    for (var i = 0; i < cRows.length; i++) {
      if (cRows[i][2].replace(/[^0-9]/g, '') === senderNumber.replace(/[^0-9]/g, '')) {
        targetCId = cRows[i][0];
        break;
      }
    }
  }

  var res = exportFinancialReportPDF(targetCId, { username: 'AxaBOT_WA', role: 'Admin' });
  if (res.success && res.fileUrl) {
    return HtmlService.createHtmlOutput('<script>window.location.href="' + res.fileUrl + '";</script>');
  }
  return ContentService.createTextOutput('Laporan PDF sedang diproses. Silakan akses kembali.');
}

function assertAdminRole(role) {
  if (!role || role.toLowerCase() !== 'admin') {
    throw new Error('Akses Ditolak: Tindakan ini hanya dapat dieksekusi oleh akun dengan Role Administrator.');
  }
}

function getSettingValue(settingKey) {
  try {
    var cleanTarget = (settingKey || '').toString().trim().toUpperCase();
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Settings');
    
    if (sheet && sheet.getLastRow() > 1) {
      var data = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues();
      for (var i = 0; i < data.length; i++) {
        var k = (data[i][0] || '').toString().trim().toUpperCase();
        if (k === cleanTarget) {
          var val = (data[i][1] || '').toString().trim();
          if (val) return val;
        }
      }
    }
    return (PropertiesService.getScriptProperties().getProperty(settingKey) || '').trim();
  } catch (e) {
    return (PropertiesService.getScriptProperties().getProperty(settingKey) || '').trim();
  }
}

function getAllSettings(currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Settings');
    if (!sheet || sheet.getLastRow() <= 1) {
      return { success: true, settings: [] };
    }

    var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 4).getDisplayValues();
    var settingsList = [];
    for (var i = 0; i < rows.length; i++) {
      settingsList.push({
        key: rows[i][0].toString().trim(),
        value: rows[i][1].toString().trim(),
        description: rows[i][2],
        updatedAt: rows[i][3]
      });
    }

    return { success: true, settings: settingsList };
  } catch (err) {
    return { success: false, message: err.toString(), settings: [] };
  }
}

function saveSetting(settingKey, settingValue, currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Settings');
    if (!sheet) throw new Error('Sheet Settings tidak ditemukan.');

    var cleanKey = (settingKey || '').toString().trim();
    var cleanVal = (settingValue || '').toString().trim();
    var nowFormatted = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'dd/MM/yyyy HH:mm:ss');
    var lastRow = sheet.getLastRow();
    var foundIndex = -1;

    if (lastRow > 1) {
      var keys = sheet.getRange(2, 1, lastRow - 1, 1).getDisplayValues();
      for (var i = 0; i < keys.length; i++) {
        if (keys[i][0].toString().trim().toUpperCase() === cleanKey.toUpperCase()) {
          foundIndex = i + 2;
          break;
        }
      }
    }

    if (foundIndex !== -1) {
      sheet.getRange(foundIndex, 2).setValue(cleanVal);
      sheet.getRange(foundIndex, 4).setValue(nowFormatted);
    } else {
      sheet.appendRow([cleanKey, cleanVal, 'Pengaturan Sistem', nowFormatted]);
    }

    SpreadsheetApp.flush();
    PropertiesService.getScriptProperties().setProperty(cleanKey, cleanVal);

    logAudit(currentUser.username, currentUser.role, 'SETTING_UPDATE', cleanKey, 'Pembaruan konfigurasi: ' + cleanKey, 'SUCCESS');
    return { success: true, message: 'Pengaturan ' + cleanKey + ' berhasil disimpan.' };
  } catch (err) {
    return { success: false, message: 'Gagal memperbarui pengaturan: ' + err.toString() };
  }
}

function saveAllSettings(settingsMap, currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);
    if (!settingsMap) throw new Error('Parameter pengaturan kosong.');

    for (var key in settingsMap) {
      if (settingsMap.hasOwnProperty(key)) {
        saveSetting(key, settingsMap[key], currentUser);
      }
    }
    return { success: true, message: 'Semua konfigurasi sistem & endpoint berhasil diperbarui!' };
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

function testGeminiConnection(apiKeyInput, modelInput, currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);
    var key = (apiKeyInput || getSettingValue('GEMINI_API_KEY') || '').toString().trim();
    if (!key) {
      return { success: false, message: 'Kunci API Gemini kosong. Masukkan API Key di tab Pengaturan.' };
    }

    var model = (modelInput || getSettingValue('GEMINI_MODEL_TEXT') || 'gemini-3.6-flash').toString().trim();
    if (model === 'gemini-2.5-flash') {
      model = 'gemini-3.6-flash';
    }

    var apiUrl = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model) + ':generateContent?key=' + encodeURIComponent(key);

    var requestBody = {
      contents: [{ parts: [{ text: 'Ping test. Jawab tepat 1 kata: AKTIF' }] }]
    };

    var options = {
      method: 'post',
      contentType: 'application/json',
      headers: {
        'Content-Type': 'application/json',
        'x-goog-api-key': key
      },
      payload: JSON.stringify(requestBody),
      muteHttpExceptions: true
    };

    var response = UrlFetchApp.fetch(apiUrl, options);
    var respCode = response.getResponseCode();
    var content = response.getContentText();

    if (respCode === 200) {
      var respJson = JSON.parse(content);
      var text = (respJson.candidates && respJson.candidates[0].content && respJson.candidates[0].content.parts[0].text) || 'Terhubung';
      return {
        success: true,
        message: 'Koneksi Sukses! API Key valid dan model ' + model + ' merespon: "' + text.trim() + '"',
        modelUsed: model
      };
    } else {
      var parsedErr = content;
      try {
        var errObj = JSON.parse(content);
        if (errObj.error && errObj.error.message) {
          parsedErr = errObj.error.message;
        }
      } catch (e) {}

      return {
        success: false,
        message: 'Google API Menolak (Status ' + respCode + '): ' + parsedErr
      };
    }
  } catch (err) {
    return { success: false, message: 'Gagal terhubung ke Google AI Studio: ' + err.toString() };
  }
}

