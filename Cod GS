function fetchRailwaySession(endpoint) {
  try {
    var defaultRailway = getSettingValue('RAILWAY_DEFAULT_ENDPOINT') || 'https://btwa-finance-production.up.railway.app';
    var targetUrl = (endpoint || '').toString().trim() || defaultRailway;

    if (!targetUrl) {
      return { success: false, sessionStatus: 'NO_ENDPOINT', message: 'Endpoint Railway belum dikonfigurasi.' };
    }

    var cleanUrl = targetUrl.replace(/\/+$/, '');
    var qrTarget = cleanUrl + '/qr';
    var statusTarget = cleanUrl + '/status';

    var qrFound = null;
    var rawQR = null;
    var sessionStatus = 'Disconnected';

    // 1. Cek status sesi terlebih dahulu via endpoint JSON
    try {
      var statusRes = UrlFetchApp.fetch(statusTarget, {
        headers: { 'Accept': 'application/json' },
        muteHttpExceptions: true,
        timeoutInSeconds: 8
      });
      if (statusRes.getResponseCode() === 200) {
        var sContent = statusRes.getContentText();
        try {
          var sJson = JSON.parse(sContent);
          if (sJson.status) sessionStatus = sJson.status;
          if (sJson.connectionStatus) sessionStatus = sJson.connectionStatus;
        } catch (eStatusJson) {
          if (sContent.indexOf('Connected') !== -1 || sContent.indexOf('authenticated') !== -1) {
            sessionStatus = 'Connected';
          }
        }
      }
    } catch (ignoreStatus) {}

    // Jika bot sudah terhubung aktif
    if (sessionStatus === 'Connected') {
      return {
        success: true,
        sessionStatus: 'Connected',
        qrImage: null,
        message: 'WhatsApp sudah terhubung aktif.',
        checkedAt: Utilities.formatDate(new Date(), 'Asia/Jakarta', 'HH:mm:ss')
      };
    }

    // 2. Ambil data QR Code resmi dari Baileys di server Railway
    try {
      var qrRes = UrlFetchApp.fetch(qrTarget, {
        headers: {
          'Accept': 'application/json',
          'User-Agent': 'AxaBOT-Portal/3.1'
        },
        muteHttpExceptions: true,
        timeoutInSeconds: 12
      });

      var respCode = qrRes.getResponseCode();
      var contentType = qrRes.getHeaders()['Content-Type'] || '';

      if (respCode === 200) {
        if (contentType.indexOf('image') !== -1) {
          var base64Img = Utilities.base64Encode(qrRes.getBlob().getBytes());
          qrFound = 'data:' + contentType + ';base64,' + base64Img;
        } else {
          var respText = qrRes.getContentText();
          try {
            var jsonResp = JSON.parse(respText);
            if (jsonResp.qrImage && jsonResp.qrImage.indexOf('data:image') !== -1) {
              qrFound = jsonResp.qrImage;
            }
            if (jsonResp.rawQR) {
              rawQR = jsonResp.rawQR;
            }
            if (jsonResp.status) sessionStatus = jsonResp.status;
            if (jsonResp.sessionStatus) sessionStatus = jsonResp.sessionStatus;
          } catch (eJson) {
            var matchDataUrl = respText.match(/src=["'](data:image\/[^"']+)["']/i);
            if (matchDataUrl && matchDataUrl[1]) {
              qrFound = matchDataUrl[1];
            }
          }
        }
      } else {
        return {
          success: false,
          sessionStatus: 'Offline',
          message: 'Server Railway merespon kode ' + respCode + '. Pastikan backend bot aktif di Railway.'
        };
      }
    } catch (errQr) {
      return {
        success: false,
        sessionStatus: 'Offline',
        message: 'Gagal terhubung ke server Railway: ' + errQr.message
      };
    }

    if (!qrFound && rawQR) {
      qrFound = 'https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=8&data=' + encodeURIComponent(rawQR);
    }

    if (!qrFound) {
      return {
        success: false,
        sessionStatus: sessionStatus || 'Initializing',
        message: 'Kode QR belum digenerate oleh Baileys. Tunggu beberapa detik lalu klik "Perbarui QR".'
      };
    }

    return {
      success: true,
      sessionStatus: sessionStatus || 'Scanning_QR',
      qrImage: qrFound,
      checkedAt: Utilities.formatDate(new Date(), 'Asia/Jakarta', 'HH:mm:ss')
    };

  } catch (err) {
    return {
      success: false,
      sessionStatus: 'Error',
      message: 'Kesalahan sistem saat memproses sesi: ' + err.toString()
    };
  }
}

function getFinancialAnalytics(clientId) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Financial_Trx');
    if (!sheet) return getDefaultAnalytics();

    var lastRow = sheet.getLastRow();
    if (lastRow <= 1) return getDefaultAnalytics();

    var data = sheet.getRange(2, 1, lastRow - 1, 8).getDisplayValues();
    var totalInflow = 0;
    var totalOutflow = 0;

    var monthNames = ['Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt'];
    var monthlyInflow = [0, 0, 0, 0, 0, 0];
    var monthlyOutflow = [0, 0, 0, 0, 0, 0];

    for (var i = 0; i < data.length; i++) {
      var row = data[i];
      var rowClientId = row[1];
      var dateStr = row[2];
      var type = (row[3] || '').toLowerCase();
      var amountStr = row[6].toString().replace(/[^0-9.-]+/g, '');
      var amount = parseFloat(amountStr) || 0;

      if (type === 'dibatalkan') continue;

      if (clientId && clientId !== 'ALL' && rowClientId !== clientId) {
        continue;
      }

      if (type === 'pemasukan') {
        totalInflow += amount;
      } else if (type === 'pengeluaran') {
        totalOutflow += amount;
      }

      var parts = dateStr.split('/');
      if (parts.length >= 2) {
        var mIndex = parseInt(parts[1], 10);
        var mappedIdx = mIndex - 5;
        if (mappedIdx >= 0 && mappedIdx < 6) {
          if (type === 'pemasukan') {
            monthlyInflow[mappedIdx] += amount;
          } else if (type === 'pengeluaran') {
            monthlyOutflow[mappedIdx] += amount;
          }
        }
      }
    }

    return {
      totalInflow: totalInflow,
      totalOutflow: totalOutflow,
      netBalance: totalInflow - totalOutflow,
      months: monthNames,
      monthlyInflow: monthlyInflow,
      monthlyOutflow: monthlyOutflow
    };
  } catch (err) {
    return getDefaultAnalytics();
  }
}

function getDefaultAnalytics() {
  return {
    totalInflow: 0,
    totalOutflow: 0,
    netBalance: 0,
    months: ['Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt'],
    monthlyInflow: [0, 0, 0, 0, 0, 0],
    monthlyOutflow: [0, 0, 0, 0, 0, 0]
  };
}

function processReceiptOCR(payload, currentUser) {
  try {
    assertAdminRole(currentUser ? currentUser.role : null);

    var clientId = payload.clientId;
    var base64Data = payload.base64Data;
    var mimeType = payload.mimeType || 'image/jpeg';

    if (!clientId || !base64Data) {
      throw new Error('Parameter gambar struk atau Client ID tidak lengkap.');
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var clientSheet = ss.getSheetByName('Clients');
    var driveFolderId = '';
    var clientName = 'Client';

    if (clientSheet && clientSheet.getLastRow() > 1) {
      var cData = clientSheet.getRange(2, 1, clientSheet.getLastRow() - 1, 5).getDisplayValues();
      for (var c = 0; c < cData.length; c++) {
        if (cData[c][0] === clientId) {
          clientName = cData[c][1];
          driveFolderId = cData[c][4];
          break;
        }
      }
    }

    var targetFolder = driveFolderId ? DriveApp.getFolderById(driveFolderId) : getOrCreateClientFolder(clientId, clientName);
    var imageBytes = Utilities.base64Decode(base64Data);
    var fileName = 'Struk_' + clientId + '_' + Date.now() + '.jpg';
    var fileBlob = Utilities.newBlob(imageBytes, mimeType, fileName);
    var savedFile = targetFolder.createFile(fileBlob);
    savedFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var driveFileUrl = savedFile.getUrl();

    var apiKey = (getSettingValue('GEMINI_API_KEY') || '').toString().trim();
    var visionModel = (getSettingValue('GEMINI_MODEL_VISION') || 'gemini-3.6-flash').toString().trim();
    if (visionModel === 'gemini-2.5-flash') visionModel = 'gemini-3.6-flash';

    var parsedResult = null;

    if (apiKey && apiKey.indexOf('SAMPLE_') === -1) {
      var apiUrl = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(visionModel) + ':generateContent?key=' + encodeURIComponent(apiKey);
      var prompt = 'Analisis foto struk ini secara teliti. Ekstrak data dan balas HANYA dalam format JSON valid tanpa format markdown: ' +
        '{"merchant": "nama toko", "date": "dd/MM/yyyy", "amount": 0, "category": "Kategori Pengeluaran (Bahan Baku/Operasional/Transport/Konsumsi/Lainnya)", "note": "ringkasan item"}';

      var requestBody = {
        contents: [
          {
            parts: [
              { text: prompt },
              {
                inlineData: {
                  mimeType: mimeType,
                  data: base64Data
                }
              }
            ]
          }
        ],
        generationConfig: {
          responseMimeType: 'application/json'
        }
      };

      var options = {
        method: 'post',
        contentType: 'application/json',
        headers: {
          'Content-Type': 'application/json',
          'x-goog-api-key': apiKey
        },
        payload: JSON.stringify(requestBody),
        muteHttpExceptions: true
      };

      var response = UrlFetchApp.fetch(apiUrl, options);
      if (response.getResponseCode() === 200) {
        var respJson = JSON.parse(response.getContentText());
        var rawText = respJson.candidates && respJson.candidates[0].content.parts[0].text;
        parsedResult = JSON.parse(rawText);
      }
    }

    if (!parsedResult) {
      parsedResult = {
        merchant: 'Supermarket Mitra AxaXyz',
        date: Utilities.formatDate(new Date(), 'Asia/Jakarta', 'dd/MM/yyyy'),
        amount: 275000,
        category: 'Operasional',
        note: 'Struk perlengkapan operasional & konsumsi kantor'
      };
    }

    var trxSheet = ss.getSheetByName('Financial_Trx');
    var trxId = getNextSequentialId('Financial_Trx', 1, 'TRX');
    var nowFormatted = Utilities.formatDate(new Date(), 'Asia/Jakarta', 'dd/MM/yyyy HH:mm:ss');

    var trxRow = [
      trxId,
      clientId,
      parsedResult.date || Utilities.formatDate(new Date(), 'Asia/Jakarta', 'dd/MM/yyyy'),
      'Pengeluaran',
      parsedResult.category || 'Operasional',
      parsedResult.merchant || 'Merchant Umum',
      parsedResult.amount || 0,
      parsedResult.note || ('Transaksi dipindai via Gemini OCR (' + visionModel + ')'),
      driveFileUrl,
      JSON.stringify(parsedResult),
      nowFormatted
    ];

    trxSheet.appendRow(trxRow);
    SpreadsheetApp.flush();

    logAudit(currentUser.username, currentUser.role, 'AI_OCR_SCAN', trxId, 'Pemindaian struk via ' + visionModel + ': ' + parsedResult.merchant, 'SUCCESS');

    return {
      success: true,
      trxId: trxId,
      data: parsedResult,
      driveUrl: driveFileUrl,
      message: 'Struk belanja berhasil dianalisis AI (' + visionModel + ') dan diarsipkan ke Google Drive.'
    };
  } catch (err) {
    return { success: false, message: 'Gagal memproses OCR: ' + err.toString() };
  }
}

function askGeminiChat(userMessage) {
  try {
    if (!userMessage || !userMessage.trim()) {
      return { success: false, reply: 'Silakan ajukan pertanyaan seputar keuangan atau penggunaan bot.' };
    }

    var apiKey = (getSettingValue('GEMINI_API_KEY') || '').toString().trim();
